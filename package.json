{
  "name": "harness-kit",
  "private": true,
  "version": "0.1.0",
  "description": "Personal multi-harness agent configuration.",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": [
      "./node_modules/pi-subagents/index.ts",
      "./node_modules/@juicesharp/rpiv-ask-user-question/index.ts",
      "./node_modules/@juicesharp/rpiv-btw/index.ts",
      "./node_modules/@juicesharp/rpiv-todo/index.ts",
      "./node_modules/pi-mcp-adapter/index.ts"
    ],
    "skills": ["./node_modules/pi-subagents/skills"],
    "prompts": ["./node_modules/pi-subagents/prompts"],
    "subagents": {
      "agents": ["./.generated/pi/agents"]
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@juicesharp/rpiv-ask-user-question": "^1.13.0",
    "@juicesharp/rpiv-btw": "^1.13.0",
    "@juicesharp/rpiv-todo": "^1.13.0",
    "pi-mcp-adapter": "^2.32.1",
    "pi-subagents": "0.67.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.4"
  }
}
